@page "/myorders/{orderId}"
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient

<NavTopBar></NavTopBar>

<div class="main">
    @if (invalidOrder)
    {
        <h2>Order not found</h2>
        <p>We're sorry but this order not longer exists'</p>
    }
    else if(OrderWithStatus == null)
    {
        <div class="track-order">
            <div class="track-order-title">
                <h2>
                    <text>Loading ...</text>
                </h2>
                <p class="ml-auto mb-0">
                    ...
                </p>
            </div>

        </div>
    }
    else
    {
        <div class="track-order">
            <div class="track-order-title">
                <h2>
                    Order placed: @OrderWithStatus
                </h2>
            </div>
        </div>
    }
</div>


@code{
    [Parameter] public int OrderId { get; set; }

    OrderWithStatus orderWithStatus;
    bool invalidOrder = false;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            orderWithStatus = await HttpClient.GetFromJsonAsync<OrderWithStatus>($"{NavigationManager.BaseUri}orders/{OrderId}");
        }
        catch(Exception ex)
        {
            invalidOrder = true;
            Console.Error.WriteLine(ex);
        }
    }

}